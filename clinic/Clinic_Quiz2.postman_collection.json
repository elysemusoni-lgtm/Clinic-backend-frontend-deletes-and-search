    {
      "name": "B1 Safe Booking",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Booking succeeds', function () { pm.response.to.have.status(200); });",
              "const appointment = pm.response.json();",
              "pm.test('New appointment starts as SCHEDULED', function () { pm.expect(appointment.status).to.eql('SCHEDULED'); });",
              "pm.collectionVariables.set('appointmentId', appointment.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
